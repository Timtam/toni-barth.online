---
// Embeds the semantic HTML that Typst generates from cv/en.json.
// Regenerate by running cv-typst/build.ps1 (or build.sh) in the repo root.
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import profilePic from '../../assets/profile.jpg';
import raw from '../../generated/resume-en.html?raw';

// Typst does not know Astro's hashed asset URLs and emits the photo with the
// symbolic path from the JSON; here it is rewritten to the optimized variant
// (same source file as in the PDF: src/assets/profile.jpg).
const photo = await getImage({ src: profilePic, width: 304 });

// Keep only the body content; head/title come from the site layout.
const body = raw
  .replace(/^[\s\S]*?<body>/, '')
  .replace(/<\/body>[\s\S]*$/, '')
  .replace(
    'src="/images/profile.jpg"',
    `src="${photo.src}" width="${photo.attributes.width}" height="${photo.attributes.height}"`,
  );
---

<Base title="Resumé">
  <h1>Resumé</h1>
  <p>
    <a href="/CV_Toni_Barth.pdf"
      >Download as accessible, tagged PDF (PDF/UA-1, English)</a
    >
  </p>
  <Fragment set:html={body} />
</Base>

<style is:global>
  /* Match the PDF layout: photo top right, contacts in two columns.
     The classes come from the Typst HTML export (cv-typst/jsonresume.typ). */
  .resume-photo {
    float: right;
    width: 9.5rem;
    height: auto;
    border-radius: 6px;
    margin: 0 0 1rem 1.5rem;
  }
  .resume-contact ul {
    columns: 2;
    column-gap: 2rem;
  }
  @media (max-width: 40rem) {
    .resume-contact ul {
      columns: 1;
    }
  }
  main h2 {
    clear: both;
  }
</style>
